{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run dev)",
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck)",
      "Bash(npm run test:*)",
      "Bash(npm test)",
      "Bash(npm run build)",
      "Bash(npm run size)",
      "Bash(npm run secrets)",
      "Bash(npx vitest:*)",
      "Bash(npx playwright test:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Read(./**/*service-account*.json)",
      "Read(./**/*-credentials.json)",
      "Read(./**/gha-creds-*.json)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(firebase deploy:*)",
      "Bash(npx firebase-tools deploy:*)",
      "Bash(gh secret set:*)",
      "Bash(gh secret delete:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|MultiEdit|NotebookEdit|Grep",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\"" }
        ]
      }
    ]
  }
}
